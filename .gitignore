# ------------------------------------
# 1. DEPENDENCIES AND BUILD ARTIFACTS
# ------------------------------------

# IGNORE NODE MODULES in the nested folder
auxwall-hr/node_modules

# Ignore other dependency caches/lock files generated by package managers
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore distribution/build folders
/dist
/build
/out

# ------------------------------------
# 2. ENVIRONMENT AND SENSITIVE FILES
# ------------------------------------

# Crucial: DO NOT COMMIT environment configuration files
.env
.env.local
.env.*.local

# ------------------------------------
# 3. TEMPORARY FILES AND OS-SPECIFIC
# ------------------------------------

/tmp
/logs
.DS_Store  # macOS files
Thumbs.db  # Windows thumbnail files

# IDE/Editor specific files (common additions)
.vscode
.idea